# Copy to .env and fill only the values you actually use.
# The app reads this file from the project root. Never commit .env.

APP_PORT=8000
DATABASE_PATH=data/app.db
LOG_DIR=data/logs
BACKUP_DIR=data/backups

# Local Ollama only. The settings page rejects any host that is not loopback.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=120
GENERATION_ATTEMPTS=3

# Scheduler process starts with the app, but both jobs stay off until Settings enables them.
START_SCHEDULER=true
TIMEZONE=Asia/Seoul

# Official Meta Graph version. Leave tokens empty until you authorize an app yourself.
META_GRAPH_VERSION=v26.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IMAGE_URL=
INSTAGRAM_DAILY_CAP=50

# Naver Cafe write API. Blog has no official write API; leave these empty for manual export.
NAVER_CAFE_ACCESS_TOKEN=
NAVER_CAFE_CLUB_ID=
NAVER_CAFE_MENU_ID=
NAVER_CAFE_DAILY_CAP=200
